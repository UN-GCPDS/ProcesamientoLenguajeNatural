# No se necesita .env para correr n8n.
# La OPENROUTER_API_KEY se pega en la UI de n8n: Credentials > OpenRouter.
# Consigue una gratuita en https://openrouter.ai/keys
# Modelo verificado en clase: nvidia/nemotron-3.5-super-vl:free (también vale meta-llama/llama-3.3-70b-instruct:free)

# Opcional: para no pasar --url en cada llamada
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/agente-logistica-unal
